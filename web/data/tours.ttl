    ph:energyEstimate 30.0 ;
    ph:inSeriesEdition <https://id.pedalhidrografi.co/passeio/PH/97> ;
    ph:linkInstagram "https://www.instagram.com/p/DZ6VH2Eub8s/"^^xsd:anyURI ;
    ph:linkRoute pas:bkbpnjf2_route ;
    schema:identifier "conhecer-cachoeira-do-corrego-augusta-e-cantar-rios-no" ;
    schema:image <https://storage.googleapis.com/phidro-state/tour_assets/ph97/announcement.jpg> .

pas:bp49gw62 a ph:Tour ;
    dcterms:date "2026-08-22T08:00:00-03:00"^^xsd:dateTime ;
    dcterms:description """Hidroviagem para celebrar as águas que vibram em nossa amiga Amanda! Sai 8h da Estação Estudantes (Mogi) - ou seja, programe-se pra sair às 6h30 da Luz ou Barra Funda. Chegamos lá por volta das 15h, batemos um marmitex pra curtir a praia onde deságua o rio Itaguaré e dormir cedo pra, no dia seguinte, seguirmos a Trilha D’Água em um roteiro literário com a @kaaete.eco. De lá, rangão e botar bike no bus pra voltar pra SP.\r
\r
🚨Recomendado pra quem já faz suave pedal 30 km+\r
\r
🚨 Leve sua bike revisada (freio!!), capacete, câmara reserva e tranca\r
\r
🚨 Vá de short de bundinha (bretelle)\r
\r
🚨 Bagageiro e mochilas acopladas na bike e não nas costas\r
\r
🚨 Levar jumbo-laricas pros dois dias"""@pt ;
    dcterms:title "Hidroviagem! Bertioga" ;
    prov:wasAttributedTo pes:wgb9b5fe ;
    ph:countAttendee 16 ;
    ph:energyEstimate 855.0 ;
    ph:inSeriesEdition <https://id.pedalhidrografi.co/passeio/Hidroviagem/1> ;
    ph:linkRoute pas:bp49gw62_route ;
    schema:identifier "hidroviagem-bertioga" ;
    schema:image <https://storage.googleapis.com/phidro-state/tour_assets/bp49gw62/announcement.jpg> .

