    ph:departedAt "2026-03-31T20:24:00-03:00"^^xsd:dateTime ;
    ph:energyEstimate 371.0 ;
    ph:inSeriesEdition <https://id.pedalhidrografi.co/passeio/PH/86> ;
    ph:linkInstagram "https://www.instagram.com/p/DWj9C_-Dxdq/?img_index=1"^^xsd:anyURI ;
