    ph:countNewcomer 1 ;
    ph:departedAt "2026-08-16T07:43:00-03:00"^^xsd:dateTime ;
    ph:departureLocation "Metro Sacomã" ;
    ph:energyEstimate 510.0 ;
    ph:inSeriesEdition <https://id.pedalhidrografi.co/passeio/PH/106> ;
    ph:linkActivity "https://www.strava.com/activities/19767722364"^^xsd:anyURI,
        "https://www.strava.com/activities/19768503450"^^xsd:anyURI,
        "https://www.strava.com/activities/19768787676"^^xsd:anyURI,
        "https://www.strava.com/activities/19768909998"^^xsd:anyURI ;
    ph:linkInstagram "https://www.instagram.com/pedalhidrografico/p/DcCKcBZmZMP/"^^xsd:anyURI ;
